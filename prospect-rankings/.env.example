# Supabase (Settings → API in the Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here   # NOT the anon key; keep secret

# Contentful (Settings → API keys → Content management tokens)
CONTENTFUL_SPACE_ID=your-space-id
CONTENTFUL_MANAGEMENT_TOKEN=CFPAT-xxxxxxxx
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_PROSPECT_TYPE=prospectProfile          # content type ID of the prospect entries
CONTENTFUL_LOCALE=en-US
